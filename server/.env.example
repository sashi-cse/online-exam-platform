# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/online_exam_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/online_exam_db?retryWrites=true&w=majority

# Authentication Security (Required)
JWT_SECRET=super_secret_production_jwt_key_replace_this_with_random_string

# Super Admin Seed Account Configuration
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=admin123

# Email OTP Delivery (Nodemailer / SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=noreply@yourdomain.com

# Mobile SMS OTP Delivery (Twilio / SMS Provider API Key)
SMS_API_KEY=your_sms_provider_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+18005550199
